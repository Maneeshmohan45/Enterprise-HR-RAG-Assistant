# Copy this file to ".env" and fill in YOUR OWN key. Never commit ".env".

# Which LLM answers the questions: "claude" or "nvidia"
LLM_PROVIDER=claude

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- NVIDIA (OpenAI-compatible) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nemotron is a reasoning model. 'false' = answer directly (recommended for this project).
# Leave empty for models that do not support it (e.g. Llama).
NVIDIA_ENABLE_THINKING=false

# Optional: sampling temperature. Leave empty to use the provider default.
LLM_TEMPERATURE=0.2

# Maximum length of the answer. Long multi-part questions need more room.
LLM_MAX_TOKENS=2048

# --- Local models (downloaded once from Hugging Face) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Request guard (prompt injection / role override) ---
# enforce = decline the whole request (default), shadow = only log what would be declined, off = disabled
INJECTION_GUARD_MODE=enforce


# --- Out-of-domain handling (V1) ---
DOMAIN_GUARD_MODE=enforce
RELEVANCE_GATE_MODE=shadow
# RELEVANCE_MIN_RERANK_SCORE=
STREAM_RESPONSES=true

NUMERIC_GATE_MODE=enforce